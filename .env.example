# Copy this file to .env and fill in your own values.

# Local MongoDB (if you have MongoDB Community Server installed and running):
MONGODB_URI=mongodb://127.0.0.1:27017/coursehub

# OR a MongoDB Atlas (cloud, free tier) connection string, e.g.:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/coursehub

PORT=5000

# Email (Gmail SMTP) — used only for the "forgot password" flow. See README
# for how to get a Gmail App Password. If left blank, reset links are printed
# to the server console instead of emailed (useful for local testing).
EMAIL_USER=
EMAIL_PASS=your16digitapppassword
EMAIL_FROM=CourseHub <youraddress@gmail.com>

# The public URL of your app, used to build the link inside password-reset emails.
# Locally this is fine as-is. After deploying, change it to your live URL, e.g.
# https://coursehub.onrender.com
APP_BASE_URL=http://localhost:5000

# Persistent video storage (Cloudinary, free tier) — REQUIRED once you deploy.
# Render/Railway/Heroku wipe locally-saved files on every restart, so without
# this, uploaded chapter videos disappear after a redeploy. Get these from
# cloudinary.com → Dashboard, after creating a free account. Leave all three
# blank for local development — uploads will just save to
# public/uploads/videos on disk instead.
CLOUDINARY_CLOUD_NAME=hgxf2obu
CLOUDINARY_API_KEY=855572136924141
CLOUDINARY_API_SECRET=Tkfyua1FN-DjawE_CkhMWq_cCjI

